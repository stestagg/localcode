#!/bin/sh
# Build (if needed) and run the localcode container: this checkout mounted at
# /workspace, gitea's state in a named volume, and its web UI on $PORT.
#
#   ./run                      interactive shell, services up behind it
#   ./run localcode hello      run one command and exit
#   ./run --build              force an image rebuild first
set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

IMAGE="${LOCALCODE_IMAGE:-localcode}"
VOLUME="${LOCALCODE_VOLUME:-localcode-data}"
PORT="${LOCALCODE_PORT:-8080}"

build=false
if [ "${1:-}" = "--build" ]; then
    build=true
    shift
fi
# Nothing to run against on a fresh clone, so build on first use too.
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    build=true
fi

if [ "$build" = true ]; then
    docker build -t "$IMAGE" "$repo/infra/docker"
fi

# -it only when there is a terminal on both ends, so `./run ... | cat` and CI
# don't trip over "the input device is not a TTY".
tty_flags=""
if [ -t 0 ] && [ -t 1 ]; then
    tty_flags="-it"
fi

echo "localcode: gitea on http://localhost:$PORT/ (state in volume '$VOLUME')" >&2

# ROOT_URL has to match what the browser types or gitea builds broken links --
# it is baked into app.ini on first boot, so a later port change needs a new
# volume (or an edit to /data/gitea/conf/app.ini).
exec docker run --rm $tty_flags \
    -v "$repo:/workspace" \
    -v "$VOLUME:/data" \
    -p "$PORT:80" \
    -e "GITEA_ROOT_URL=http://localhost:$PORT/" \
    "$IMAGE" "$@"
