#!/bin/sh
# Hand the agent's own instructions to opencode and let it change the clone.
#
# This is the runner that makes an agent an agent; `hello` only proves the
# plumbing around it. It needs a provider configured out on the host -- see
# `localcode llm auth login` -- since the entrypoint only writes the files it was
# given, and writes nothing when it was given nothing.
set -eu

: "${LOCALCODE_PERSONA:?the agent persona has no name}"
: "${LOCALCODE_ROLE:?the agent role has no name}"
: "${LOCALCODE_PERSONA_PROMPT:?the persona definition has no instructions}"
: "${LOCALCODE_ROLE_PROMPT:?the role definition has no instructions}"

if ! command -v opencode >/dev/null 2>&1; then
    echo "opencode: not in this image; rebuild with --rebuild" >&2
    exit 2
fi

config="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
if [ ! -f "$config" ]; then
    echo "opencode: no configuration reached this container." >&2
    echo "opencode: run 'localcode llm auth login' on the host first." >&2
    exit 2
fi

# The agent's markdown is the instruction; the rest is the situation it is in.
# Everything after the edits -- the commit, the branch, the pull request -- is
# the entrypoint's job, so the model is told not to attempt it.
prompt=$(cat <<EOF
# Persona: $LOCALCODE_PERSONA

$LOCALCODE_PERSONA_PROMPT

# Role: $LOCALCODE_ROLE

$LOCALCODE_ROLE_PROMPT

You are the '$LOCALCODE_PERSONA' persona, working in the '$LOCALCODE_ROLE' role on
$LOCALCODE_OWNER/$LOCALCODE_REPO. The repository is checked out in the current
directory, on the '$LOCALCODE_METADATA_BRANCH' branch, and project metadata is
under .localcode/.

Make the changes the work needs, then stop. Do not commit, branch, push or open
a pull request: that happens automatically once you exit.
EOF
)

echo "opencode: $(opencode --version 2>/dev/null || echo 'version unknown')"
opencode run "$prompt"
