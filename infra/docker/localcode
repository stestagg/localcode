#!/bin/sh
# `localcode` in the container is a shim over the mounted checkout: no install
# step, and no reinstall after an edit.
set -eu

src="${LOCALCODE_SRC:-/workspace}"

# Without this check `uv run` finds no project, leaves the venv off PATH, and
# resolves `localcode` back to this script -- a recursion, not a useful error.
if [ ! -f "$src/pyproject.toml" ]; then
    echo "localcode: no checkout at $src" >&2
    echo "localcode: mount one there (docker run -v \"\$PWD:$src\" ...) or point LOCALCODE_SRC at it" >&2
    exit 1
fi

# `python -m` rather than the `localcode` entry point: same code, but it can
# never resolve back to this shim.
exec uv run --project "$src" python -m localcode "$@"
